CREATE CONSTRAINT storekey_name IF NOT EXISTS FOR (n:StoreKey) REQUIRE n.name IS UNIQUE;
CREATE CONSTRAINT action_name IF NOT EXISTS FOR (n:Action) REQUIRE n.name IS UNIQUE;
