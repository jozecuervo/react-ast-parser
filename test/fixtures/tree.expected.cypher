MERGE (n:Component {name: 'App'}) SET n.file = 'App.jsx', n.parseError = false, n.state = ['filter', 'showDone'];
MERGE (n:Component {name: 'Counter'}) SET n.file = 'Counter.jsx', n.parseError = false, n.state = ['Hook: useState'];
